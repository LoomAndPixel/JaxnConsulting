{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": true,
			"palette": [
				{ "slug": "paper", "name": "Paper", "color": "#F4EFE6" },
				{ "slug": "card", "name": "Card", "color": "#FBF8F2" },
				{ "slug": "sand", "name": "Sand", "color": "#EAE3D6" },
				{ "slug": "ink", "name": "Ink", "color": "#1C211E" },
				{ "slug": "slate", "name": "Slate", "color": "#3E4440" },
				{ "slug": "stone", "name": "Stone", "color": "#585E59" },
				{ "slug": "rule", "name": "Rule", "color": "#CFC6B6" },
				{ "slug": "line", "name": "Line", "color": "#DDD4C4" },
				{ "slug": "green", "name": "Jaxn Green", "color": "#1F4D3B" },
				{ "slug": "green-dark", "name": "Green, hover", "color": "#143427" },
				{ "slug": "rust", "name": "Rust", "color": "#A8492A" },
				{ "slug": "coral", "name": "Coral", "color": "#E9A27F" },
				{ "slug": "mint", "name": "Mint", "color": "#D9E3DC" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"spacing": {
			"units": ["px", "em", "rem", "%", "vw"],
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "10", "name": "XS", "size": "8px" },
				{ "slug": "20", "name": "S", "size": "16px" },
				{ "slug": "30", "name": "M", "size": "24px" },
				{ "slug": "40", "name": "L", "size": "clamp(28px, 3vw, 40px)" },
				{ "slug": "50", "name": "XL", "size": "clamp(40px, 5vw, 64px)" },
				{ "slug": "60", "name": "2XL", "size": "clamp(56px, 7vw, 96px)" },
				{ "slug": "70", "name": "Section", "size": "clamp(72px, 9.5vw, 136px)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "display",
					"name": "Fraunces",
					"fontFamily": "Fraunces, Georgia, serif",
					"fontFace": [
						{ "fontFamily": "Fraunces", "fontStyle": "normal", "fontWeight": "100 900", "fontDisplay": "swap", "src": ["file:./assets/fonts/fraunces.woff2"] },
						{ "fontFamily": "Fraunces", "fontStyle": "italic", "fontWeight": "100 900", "fontDisplay": "swap", "src": ["file:./assets/fonts/fraunces-italic.woff2"] }
					]
				},
				{
					"slug": "body",
					"name": "Instrument Sans",
					"fontFamily": "'Instrument Sans', system-ui, -apple-system, 'Segoe UI', sans-serif",
					"fontFace": [
						{ "fontFamily": "Instrument Sans", "fontStyle": "normal", "fontWeight": "400 700", "fontDisplay": "swap", "src": ["file:./assets/fonts/instrument-sans.woff2"] },
						{ "fontFamily": "Instrument Sans", "fontStyle": "italic", "fontWeight": "400 700", "fontDisplay": "swap", "src": ["file:./assets/fonts/instrument-sans-italic.woff2"] }
					]
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "15px", "fluid": false },
				{ "slug": "medium", "name": "Body", "size": "17px", "fluid": false },
				{ "slug": "large", "name": "Lead", "size": "21px", "fluid": { "min": "18px", "max": "21px" } },
				{ "slug": "x-large", "name": "Heading S", "size": "36px", "fluid": { "min": "28px", "max": "36px" } },
				{ "slug": "xx-large", "name": "Heading", "size": "60px", "fluid": { "min": "40px", "max": "60px" } },
				{ "slug": "huge", "name": "Display", "size": "96px", "fluid": { "min": "48px", "max": "96px" } }
			]
		},
		"blocks": {
			"core/button": { "border": { "radius": false } }
		}
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--paper)", "text": "var(--wp--preset--color--ink)" },
		"spacing": {
			"blockGap": "24px",
			"padding": { "left": "clamp(20px, 8.34vw, 120px)", "right": "clamp(20px, 8.34vw, 120px)", "top": "0", "bottom": "0" }
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": { "text": "var(--wp--preset--color--green)" },
				":hover": { "color": { "text": "var(--wp--preset--color--green-dark)" } }
			},
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--display)", "fontWeight": "500", "lineHeight": "1.05", "letterSpacing": "-0.02em" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)", "lineHeight": "0.98", "letterSpacing": "-0.035em" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "lineHeight": "1.02", "letterSpacing": "-0.03em" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h4": { "typography": { "fontSize": "24px" } },
			"button": {
				"color": { "background": "var(--wp--preset--color--green)", "text": "var(--wp--preset--color--white)" },
				"border": { "radius": "999px" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "18px", "fontWeight": "500", "lineHeight": "1" },
				"spacing": { "padding": { "top": "20px", "bottom": "20px", "left": "30px", "right": "30px" } },
				":hover": { "color": { "background": "var(--wp--preset--color--green-dark)", "text": "var(--wp--preset--color--white)" } },
				":focus": { "color": { "background": "var(--wp--preset--color--green-dark)", "text": "var(--wp--preset--color--white)" } }
			}
		},
		"blocks": {
			"core/paragraph": { "color": { "text": "var(--wp--preset--color--slate)" } },
			"core/separator": { "color": { "text": "var(--wp--preset--color--rule)" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	],
	"customTemplates": [
		{ "name": "page-no-title", "title": "Page without title (designed layout)", "postTypes": ["page"] }
	]
}
